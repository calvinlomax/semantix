# Paths are relative to the repository root, or absolute.
SEMANTIX_MODEL_PATH=data/models/google-news-300.kv
SEMANTIX_VOCABULARY_PATH=data/vocabulary/words.txt
SEMANTIX_LEVELS_PATH=data/levels/catalog.json
# true only for original word2vec binary (.bin or .bin.gz), never native .kv
SEMANTIX_MODEL_BINARY=false
# Optional limit for original binary loading (not mmap); blank loads all.
SEMANTIX_MODEL_LIMIT=
SEMANTIX_MOMENTUM=0.35
SEMANTIX_IMPULSE=0.45
# direction (default) or displacement; regenerate levels when this changes.
SEMANTIX_MOVEMENT_MODEL=direction
SEMANTIX_MAX_GAMES=1000
SEMANTIX_GAME_TTL=86400
SEMANTIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
